# Copy to terraform.tfvars (gitignored) and fill in. Or pass via TF_VAR_* env vars.

project_id        = "prooftamil"
region            = "asia-south1"
github_owner      = "palkani"
github_repo       = "prooftamil"
deployer_sa_email = "gh-deployer@prooftamil.iam.gserviceaccount.com"

# Optional: the Cloud Run runtime SA (leave unset to use the default Compute SA).
# runtime_sa_email = "prooftamil-run@prooftamil.iam.gserviceaccount.com"

# The only app secret you must supply. Prefer TF_VAR_gemini_api_key as an env var
# over writing it into this file. (JWT keypair is generated by Terraform.)
gemini_api_key = "AIza..."
